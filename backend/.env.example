# --- Live Arts ERP backend env (template) ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/live_arts_erp?retryWrites=true&w=majority
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

ENABLE_QUEUES=true

TZ=Asia/Kolkata
CORS_ORIGINS=*

PAYROLL_FLOOR_NEGATIVE_LEAVE_DEDUCTION=false

SEED_ADMIN_EMAIL=admin@livearts.local
SEED_ADMIN_PASSWORD=change_me
