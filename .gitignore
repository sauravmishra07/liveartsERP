# deps
node_modules/
**/node_modules/

# env — never commit real secrets
.env
.env.*
!.env.example
# Safe to commit: no secrets, just the same-origin API path for production builds.
!.env.production

# netlify
.netlify/

# Deprecated Expo app kept only as a local archive. It carries its own .git, so
# committing it made Git record a submodule pointer with no .gitmodules entry —
# which breaks `git clone` on CI (Netlify "No url found for submodule path").
frontend/

# builds
dist/
build/
**/dist/
web-build/

# expo
.expo/
.expo-shared/

# logs / os
*.log
.DS_Store
coverage/
